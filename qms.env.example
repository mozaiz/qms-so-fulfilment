# Copy this to qms.env and edit it. install.sh writes one for you.
#
# Everything here can also be passed as a normal environment variable, which is
# what the systemd unit and Docker do.

# --- identity ---------------------------------------------------------------
# Printed on the QR wall sign and used in exported filenames.
# Set this per outlet. Blank is fine until you do.
QMS_STORE_CODE=
QMS_STORE_NAME="Machines Store"

# --- network ----------------------------------------------------------------
QMS_PORT=8099
# Whose name is on the certificate that phones install. Shows in the phone's
# certificate details and on the iOS profile install screen. Changing it is a
# different certificate authority, so every phone must install the certificate
# again.
QMS_CERT_ORG="Zairi Khaidzir @ Mozaiz"

# --- storage ----------------------------------------------------------------
# One file. Contains everything. Back this up.
QMS_DB=/opt/qms/qms.db

# --- behaviour --------------------------------------------------------------
# An SO that has been scanned but not claimed by any POS for this many minutes
# turns red so someone notices the customer is still waiting.
QMS_STALE_MIN=15

# A claimed SO not walked to the POS within this many minutes turns red.
QMS_SLA_MIN=10

# An SO sitting at the counter that the POS has not marked complete within this
# many minutes turns red. This is the one that matters most — the customer has
# their goods, so a stale entry here makes the queue look longer than it is.
QMS_COMPLETE_MIN=10

# Ignore the same barcode being scanned again within this window (accidental
# double-tap, or the camera reading it twice).
QMS_DEDUPE_MIN=5

# How many POS counters exist on a fresh install. Add more later from the
# Setup screen — no restart, no config edit.
QMS_POS_COUNT=4

# Hard ceiling for the "Add POS" button.
QMS_MAX_POS=20

# --- locale -----------------------------------------------------------------
QMS_TZ=Asia/Kuala_Lumpur
