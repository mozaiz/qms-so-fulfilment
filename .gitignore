# --- databases: never commit. patient data, one file, easy to leak by accident
*.db
*.db-wal
*.db-shm
*.db.bak
*.db.bak.*

# --- runtime / install artefacts -------------------------------------------
venv/
.venv/
__pycache__/
*.py[cod]
qms.env

# --- the store's certificate authority and server keys ----------------------
# ca.key can sign a certificate for ANY hostname on earth. It belongs on one
# store box and nowhere else — committing it would let anyone impersonate any
# site to every phone that installed the CA.
certs/
*.mobileconfig

# --- generated output -------------------------------------------------------
screens/
qr_card_*.png
qr_card_*.pdf
test_barcodes.png
*.log

# --- release packaging ------------------------------------------------------
dist/
qms-*.zip
qms-*.tar.gz
SHA256SUMS.txt
